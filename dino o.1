<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>DINO CORRIDOR</title>
<style>
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body {
    margin: 0; padding: 0; width: 100%; height: 100%;
    overflow: hidden; background: #0a0806;
    touch-action: none; user-select: none; -webkit-user-select: none;
    font-family: 'Courier New', monospace;
  }
  canvas { display: block; }

  #hud {
    position: fixed; top: 0; left: 0; right: 0;
    padding: 12px 16px;
    display: flex; justify-content: space-between; align-items: flex-start;
    pointer-events: none;
    z-index: 5;
  }
  .hud-block {
    background: rgba(10,8,6,0.55);
    border: 1px solid rgba(180,60,40,0.5);
    padding: 6px 12px;
    color: #e8dcc8;
    font-size: 14px;
    letter-spacing: 1px;
    min-width: 110px;
  }
  #healthLabel { color: #d94f3a; font-weight: bold; }
  #healthBarWrap {
    width: 100px; height: 6px; background: #200; margin-top: 4px;
    border: 1px solid #500;
  }
  #healthBar { height: 100%; background: #d94f3a; width: 100%; transition: width 0.15s; }
  #weaponLabel { display: block; margin-top: 5px; font-size: 10px; letter-spacing: 1px; color: #c9bda6; }
  #scoreBlock { text-align: right; }

  #damageFlash {
    position: fixed; inset: 0; z-index: 8; pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(160,0,0,0) 35%, rgba(150,0,0,0.65) 100%);
    opacity: 0; transition: opacity 0.4s ease-out;
  }
  #damageFlash.active { opacity: 1; transition: opacity 0.03s; }
  #lowHealthVignette {
    position: fixed; inset: 0; z-index: 7; pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(120,0,0,0) 45%, rgba(120,0,0,0.55) 100%);
    opacity: 0; transition: opacity 0.6s ease;
  }

  #crosshair {
    position: fixed; top: 50%; left: 50%;
    transform: translate(-50%,-50%);
    width: 22px; height: 22px;
    pointer-events: none; z-index: 5;
  }
  #crosshair::before, #crosshair::after {
    content: ''; position: absolute; background: rgba(232,220,200,0.85);
  }
  #crosshair::before { top: 50%; left: 2px; right: 2px; height: 2px; transform: translateY(-50%); }
  #crosshair::after { left: 50%; top: 2px; bottom: 2px; width: 2px; transform: translateX(-50%); }
  #crosshair.hit::before, #crosshair.hit::after { background: #d94f3a; }

  .stick-base {
    position: fixed; border-radius: 50%;
    background: rgba(232,220,200,0.08);
    border: 1px solid rgba(232,220,200,0.35);
    z-index: 6;
  }
  .stick-nub {
    position: absolute; border-radius: 50%;
    background: rgba(217,79,58,0.55);
    border: 1px solid rgba(232,220,200,0.5);
    top: 50%; left: 50%;
    transform: translate(-50%,-50%);
  }

  #fireBtn {
    position: fixed; border-radius: 50%;
    background: rgba(217,79,58,0.25);
    border: 2px solid rgba(217,79,58,0.75);
    color: #e8dcc8; font-size: 12px; letter-spacing: 1px;
    display: flex; align-items: center; justify-content: center;
    z-index: 6;
  }
  #fireBtn.pressed { background: rgba(217,79,58,0.6); }

  #overlay {
    position: fixed; inset: 0; z-index: 10;
    background: rgba(8,6,5,0.92);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    color: #e8dcc8; text-align: center; padding: 24px;
  }
  #overlay h1 {
    font-size: 30px; margin: 0 0 12px; color: #d94f3a;
    letter-spacing: 2px;
  }
  #overlay p { font-size: 14px; line-height: 1.6; max-width: 320px; color: #c9bda6; }
  #overlay button {
    margin-top: 22px; padding: 14px 30px;
    background: #d94f3a; border: none; color: #0a0806;
    font-size: 15px; font-weight: bold; letter-spacing: 1px;
    font-family: inherit; cursor: pointer;
  }
  .hidden { display: none !important; }

  #rotatePrompt {
    display: none; position: fixed; inset: 0; z-index: 50;
    background: #0a0806; color: #e8dcc8; text-align: center;
    flex-direction: column; align-items: center; justify-content: center;
    padding: 24px; gap: 14px;
  }
  #rotatePrompt .icon { font-size: 46px; animation: spinPrompt 1.8s ease-in-out infinite; }
  #rotatePrompt p { font-size: 14px; color: #c9bda6; max-width: 260px; line-height: 1.5; }
  @keyframes spinPrompt {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(-90deg); }
  }
  @media (orientation: landscape) and (pointer: coarse) {
    #rotatePrompt { display: flex; }
    #hud, #crosshair, .stick-base, #fireBtn, #overlay { display: none !important; }
  }

  .section-label { font-size: 11px; letter-spacing: 2px; color: #8a7c66; margin: 2px 0 8px; }
  #profileStats {
    font-size: 12px; color: #8ecae6; margin: 0 0 14px; text-align: center;
    line-height: 1.6;
  }
  .level-buttons { display: flex; gap: 8px; margin-bottom: 18px; width: 100%; max-width: 300px; }
  .levelBtn {
    flex: 1; margin-top: 0; padding: 10px 4px;
    background: #150f0c; border: 1px solid rgba(217,79,58,0.35); color: #c9bda6;
    font-family: inherit; font-size: 20px; border-radius: 2px;
    display: flex; flex-direction: column; align-items: center; gap: 4px;
  }
  .levelBtn .lname { font-size: 10px; letter-spacing: 1px; }
  .levelBtn .ldiff { font-size: 8px; letter-spacing: 1px; color: #8a7c66; }
  .levelBtn.selected { border-color: #d94f3a; background: rgba(217,79,58,0.18); color: #e8dcc8; }

  .mode-buttons { display: flex; gap: 12px; }
  .mode-buttons button { margin-top: 0; }
  #onlineBtn.disabled { opacity: 0.4; }
  #onlineForm {
    margin-top: 16px; display: flex; flex-direction: column; gap: 10px;
    width: 100%; max-width: 260px;
  }
  #onlineForm input {
    background: #150f0c; border: 1px solid rgba(217,79,58,0.5); color: #e8dcc8;
    padding: 11px 12px; font-family: inherit; font-size: 14px; letter-spacing: 1px;
    text-transform: uppercase; text-align: center; border-radius: 2px;
  }
  #roomRow { display: flex; gap: 8px; }
  #roomRow input { flex: 1; }
  #roomRow button {
    margin: 0; padding: 0 14px; background: #3d2a20; border: 1px solid rgba(217,79,58,0.5);
    color: #e8dcc8; font-size: 17px; border-radius: 2px;
  }
  #joinBtn { margin-top: 2px; }
  #mpNote { font-size: 11px; color: #8a7c66; line-height: 1.5; }
  #mpStatus { display: block; margin-top: 4px; font-size: 11px; color: #8ecae6; }
  #menuBtn {
    margin-top: 10px; padding: 8px; background: transparent; border: none;
    color: #8a7c66; text-decoration: underline; font-size: 12px; font-weight: normal;
  }
  #desktopHint {
    position: fixed; bottom: 14px; left: 50%; transform: translateX(-50%);
    background: rgba(10,8,6,0.6); border: 1px solid rgba(232,220,200,0.25);
    color: #c9bda6; font-size: 12px; letter-spacing: 0.5px;
    padding: 8px 16px; border-radius: 3px; z-index: 6; pointer-events: none;
    white-space: nowrap;
  }
</style>
</head>
<body>

<canvas id="game"></canvas>

<div id="rotatePrompt">
  <div class="icon">📱</div>
  <p>DINO CORRIDOR se joue en position verticale.<br>Tourne ton téléphone pour continuer.</p>
</div>

<div id="damageFlash"></div>
<div id="lowHealthVignette"></div>

<div id="hud">
  <div class="hud-block">
    <span id="healthLabel">VIE</span>
    <div id="healthBarWrap"><div id="healthBar"></div></div>
    <span id="weaponLabel">🔫 PISTOLET</span>
  </div>
  <div class="hud-block" id="scoreBlock">
    SCORE <span id="score">0</span><br>
    DINOS <span id="enemiesLeft">0</span>
    <span id="mpStatus"></span>
  </div>
</div>

<div id="crosshair"></div>

<div id="overlay">
  <h1 id="ovTitle">DINO CORRIDOR</h1>
  <p id="ovText">
    Des dinosaures rôdent dans les couloirs.<br><br>
    Joystick gauche : se déplacer.<br>
    Joystick droit : regarder / viser.<br>
    Bouton rouge : tirer.
  </p>

  <div id="modeSelect">
    <p id="profileStats">Chargement du profil…</p>
    <p class="section-label">CHOISIS UN NIVEAU</p>
    <div class="level-buttons">
      <button class="levelBtn selected" data-level="0">🏚️<span class="lname">Couloirs</span><span class="ldiff">Facile</span></button>
      <button class="levelBtn" data-level="1">🕯️<span class="lname">Grotte</span><span class="ldiff">Moyen</span></button>
      <button class="levelBtn" data-level="2">🌲<span class="lname">Forêt</span><span class="ldiff">Difficile</span></button>
    </div>
    <div class="mode-buttons">
      <button id="soloBtn">SOLO</button>
      <button id="onlineBtn">EN LIGNE</button>
    </div>
    <div id="onlineForm" class="hidden">
      <input id="nickInput" maxlength="12" placeholder="PSEUDO">
      <div id="roomRow">
        <input id="roomInput" maxlength="6" placeholder="CODE SALLE">
        <button id="randomRoomBtn" type="button">🎲</button>
      </div>
      <button id="joinBtn" type="button">REJOINDRE</button>
      <span id="mpNote">Donne ce code à tes amis pour jouer dans la même salle (même niveau choisi ci-dessus). Synchronisation légère (pas temps réel), coop contre les mêmes dinosaures.</span>
    </div>
  </div>

  <button id="restartBtn" class="hidden">JOUER</button>
  <button id="menuBtn" class="hidden">Choisir un autre niveau</button>
</div>

<script>
(function(){
  const canvas = document.getElementById('game');
  const ctx = canvas.getContext('2d');
  const overlay = document.getElementById('overlay');
  const ovTitle = document.getElementById('ovTitle');
  const ovText = document.getElementById('ovText');
  const modeSelect = document.getElementById('modeSelect');
  const profileStatsEl = document.getElementById('profileStats');
  const levelBtns = Array.from(document.querySelectorAll('.levelBtn'));
  const soloBtn = document.getElementById('soloBtn');
  const onlineBtn = document.getElementById('onlineBtn');
  const onlineForm = document.getElementById('onlineForm');
  const nickInput = document.getElementById('nickInput');
  const roomInput = document.getElementById('roomInput');
  const randomRoomBtn = document.getElementById('randomRoomBtn');
  const joinBtn = document.getElementById('joinBtn');
  const restartBtn = document.getElementById('restartBtn');
  const menuBtn = document.getElementById('menuBtn');
  const mpStatusEl = document.getElementById('mpStatus');
  const mpNoteEl = document.getElementById('mpNote');
  const healthBar = document.getElementById('healthBar');
  const weaponLabelEl = document.getElementById('weaponLabel');
  const damageFlashEl = document.getElementById('damageFlash');
  const lowHealthVignetteEl = document.getElementById('lowHealthVignette');
  const scoreEl = document.getElementById('score');
  const enemiesLeftEl = document.getElementById('enemiesLeft');
  const crosshair = document.getElementById('crosshair');

  let W, H, focal;
  const PLANE_LEN = 0.72; // FOV horizontal ~72°, plus confortable en écran étroit (portrait)
  function resize(){
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
    focal = (W/2) / PLANE_LEN; // focale indépendante de la hauteur -> plus de distorsion en portrait
  }
  window.addEventListener('resize', resize);
  resize();

  // ---------- NIVEAUX ----------
  const LEVELS = [
    {
      name: 'Couloirs', size: 13, enemyCount: 7,
      enemyHp: 60, enemySpeed: 1.1, enemyDmg: 12, weaponChance: 0.30,
      wallA: [120, 55, 40], wallB: [104, 50, 38],
      sky: ['#2a1810', '#1a1008'], floor: '#0f0c08', flicker: false
    },
    {
      name: 'Grotte', size: 15, enemyCount: 9,
      enemyHp: 70, enemySpeed: 1.3, enemyDmg: 15, weaponChance: 0.20,
      wallA: [96, 90, 86], wallB: [66, 62, 60],
      sky: ['#141414', '#0a0a0a'], floor: '#0e0c0a', flicker: true
    },
    {
      name: 'Forêt', size: 17, enemyCount: 11,
      enemyHp: 80, enemySpeed: 1.55, enemyDmg: 18, weaponChance: 0.10,
      wallA: [56, 82, 40], wallB: [92, 66, 34],
      sky: ['#0e1f0c', '#081a08'], floor: '#0c1408', flicker: false
    }
  ];

  // ---------- MAP ----------
  let SIZE = LEVELS[0].size;
  let MAP = null;
  function generateMap(size){
    const m = [];
    for (let y = 0; y < size; y++){
      const row = [];
      for (let x = 0; x < size; x++){
        if (x === 0 || y === 0 || x === size-1 || y === size-1) row.push(1);
        else if (x % 2 === 0 && y % 2 === 0) row.push(1);
        else row.push(0);
      }
      m.push(row);
    }
    return m;
  }

  function isWall(x, y){
    const ix = Math.floor(x), iy = Math.floor(y);
    if (ix < 0 || iy < 0 || ix >= SIZE || iy >= SIZE) return true;
    return MAP[iy][ix] === 1;
  }

  function pickOpenSpots(size, count, excluded){
    const cells = [];
    for (let y = 1; y < size-1; y++){
      for (let x = 1; x < size-1; x++){
        if (x % 2 === 0 && y % 2 === 0) continue; // pilier
        if (Math.hypot(x-1, y-1) < 3.2) continue; // pas trop près du départ
        if (excluded && excluded.has(x+','+y)) continue;
        cells.push([x, y]);
      }
    }
    for (let i = cells.length-1; i > 0; i--){
      const j = Math.floor(Math.random()*(i+1));
      [cells[i], cells[j]] = [cells[j], cells[i]];
    }
    return cells.slice(0, count);
  }

  // ---------- GAME STATE ----------
  let player, enemies, pickups, score, running, zBuffer;
  let currentLevel = 0;
  let pendingLevel = 0;

  function resetGame(levelIndex){
    if (levelIndex !== undefined) currentLevel = levelIndex;
    const cfg = LEVELS[currentLevel];
    SIZE = cfg.size;
    MAP = generateMap(SIZE);

    player = {
      x: 1.5, y: 1.5,
      dirX: 1, dirY: 0,
      planeX: 0, planeY: PLANE_LEN,
      health: 100,
      fireCooldown: 0,
      weapon: 'pistol'
    };
    const spots = pickOpenSpots(SIZE, cfg.enemyCount);
    enemies = spots.map(([ex,ey], i) => ({
      x: ex + 0.5, y: ey + 0.5,
      hp: cfg.enemyHp, maxHp: cfg.enemyHp, alive: true,
      type: i % 2 === 0 ? 'trex' : 'carno',
      palette: randomPalette(),
      spriteSet: null,
      hitFlash: 0,
      transformX: 0, transformY: -1,
      attackCooldown: 0
    }));

    const usedKeys = new Set(spots.map(([x,y]) => x+','+y));
    pickups = [];
    for (const type of ['shotgun', 'sword']){
      if (Math.random() < cfg.weaponChance){
        const spot = pickOpenSpots(SIZE, 1, usedKeys)[0];
        if (spot){
          usedKeys.add(spot[0]+','+spot[1]);
          pickups.push({ x: spot[0]+0.5, y: spot[1]+0.5, type, collected: false, transformX:0, transformY:-1 });
        }
      }
    }

    score = 0;
    updateHUD();
    updateWeaponUI();
  }

  function updateHUD(){
    const pct = Math.max(0, player.health);
    healthBar.style.width = pct + '%';
    scoreEl.textContent = score;
    enemiesLeftEl.textContent = enemies.filter(e => e.alive).length;
    lowHealthVignetteEl.style.opacity = player.health < 35 ? String(Math.min(0.8, (35-player.health)/35*0.8)) : '0';
    if (mp.enabled){
      const count = Object.keys(mp.others).length + 1;
      mpStatusEl.textContent = `🌐 ${mp.room} · ${LEVELS[mp.level].name} · ${count} joueur${count > 1 ? 's' : ''}`;
    } else {
      mpStatusEl.textContent = '';
    }
  }

  let damageFlashTimer = null;
  function flashDamage(){
    damageFlashEl.classList.add('active');
    clearTimeout(damageFlashTimer);
    damageFlashTimer = setTimeout(() => damageFlashEl.classList.remove('active'), 90);
  }

  // ---------- ARMES ----------
  const WEAPONS = {
    pistol:  { label: '🔫 PISTOLET', fireLabel: 'TIRER', cooldown: 0.28, angleTol: 0.18, melee: false, dmg: () => 30 },
    shotgun: { label: '💥 FUSIL À POMPE', fireLabel: 'TIRER', cooldown: 0.55, angleTol: 0.32, melee: false, dmg: (en) => Math.ceil(en.maxHp/2) + 2 },
    sword:   { label: '🗡️ ÉPÉE', fireLabel: 'FRAPPER', cooldown: 0.38, angleTol: 0.55, melee: true, meleeRange: 1.3, dmg: (en) => en.maxHp + 5 }
  };

  function updateWeaponUI(){
    const w = WEAPONS[player.weapon];
    weaponLabelEl.textContent = w.label;
    if (fireBtn) fireBtn.textContent = w.fireLabel;
  }

  // ---------- PROFIL JOUEUR (stats persistantes entre les sessions) ----------
  const profileAvailable = typeof window.storage !== 'undefined' && typeof window.storage.get === 'function';
  let profile = { totalKills: 0, totalGames: 0, bestScore: 0, cleared: [0, 0, 0] };

  function renderProfileUI(){
    const best = profile.cleared.reduce((a,b) => a+b, 0);
    profileStatsEl.textContent = `🦖 ${profile.totalKills} dinosaures éliminés · 🏆 meilleur score ${profile.bestScore} · 🚪 ${best} niveaux réussis`;
  }

  function saveProfile(){
    if (!profileAvailable) return;
    try { window.storage.set('profile:stats', JSON.stringify(profile), false); } catch(e){}
  }

  async function loadProfile(){
    renderProfileUI();
    if (!profileAvailable){
      profileStatsEl.textContent = 'Profil non disponible dans ce navigateur (ouvre le jeu depuis l\'aperçu Claude).';
      return;
    }
    try {
      const res = await window.storage.get('profile:stats', false);
      if (res && res.value){
        const saved = JSON.parse(res.value);
        profile = Object.assign(profile, saved);
        if (!Array.isArray(profile.cleared) || profile.cleared.length !== 3) profile.cleared = [0,0,0];
      }
    } catch(e){ /* premier lancement : pas encore de profil sauvegardé */ }
    renderProfileUI();
  }

  // ---------- MULTIJOUEUR (via le stockage partagé de l'artefact) ----------
  const mpAvailable = typeof window.storage !== 'undefined' && typeof window.storage.get === 'function';
  const MP_PUSH_INTERVAL = 0.6;
  const MP_PULL_INTERVAL = 1.4;
  let mp = { enabled: false, room: null, level: 0, playerId: null, nick: '', others: {} };
  let mpPushTimer = 0, mpPullTimer = 0;

  function randomCode(len){
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    let s = '';
    for (let i = 0; i < len; i++) s += chars[Math.floor(Math.random()*chars.length)];
    return s;
  }

  async function mpJoin(room, nick, levelIndex){
    mp.enabled = true;
    mp.room = (room || '').toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,6) || 'GLOBAL';
    mp.level = levelIndex;
    mp.playerId = randomCode(8);
    mp.nick = (nick || 'Joueur').trim().slice(0,12) || 'Joueur';
    mp.others = {};
    mpPushTimer = 0; mpPullTimer = 0;

    try {
      const res = await window.storage.get(`mp:${mp.room}:${mp.level}:enemies`, true);
      if (res && res.value){
        const remote = JSON.parse(res.value);
        remote.forEach((r, i) => {
          if (enemies[i]){ enemies[i].hp = Math.min(enemies[i].hp, r.hp); enemies[i].alive = enemies[i].alive && r.alive; }
        });
      }
    } catch(e){ /* pas de salle existante, on en crée une nouvelle */ }
    await mpPushEnemies();
    await mpPushPlayer();
  }

  async function mpPushPlayer(){
    if (!mp.enabled) return;
    try {
      const state = { nick: mp.nick, x: player.x, y: player.y, health: player.health, score, ts: Date.now() };
      await window.storage.set(`mp:${mp.room}:${mp.level}:player:${mp.playerId}`, JSON.stringify(state), true);
    } catch(e){}
  }

  async function mpPushEnemies(){
    if (!mp.enabled) return;
    try {
      const local = enemies.map(e => ({ hp: e.hp, alive: e.alive }));
      let merged = local;
      const res = await window.storage.get(`mp:${mp.room}:${mp.level}:enemies`, true).catch(() => null);
      if (res && res.value){
        const remote = JSON.parse(res.value);
        merged = local.map((l, i) => {
          const r = remote[i] || l;
          return { hp: Math.min(l.hp, r.hp), alive: l.alive && r.alive };
        });
        merged.forEach((m, i) => { if (enemies[i]){ enemies[i].hp = m.hp; enemies[i].alive = m.alive; } });
      }
      await window.storage.set(`mp:${mp.room}:${mp.level}:enemies`, JSON.stringify(merged), true);
    } catch(e){}
    updateHUD();
  }

  async function mpPullPlayers(){
    if (!mp.enabled) return;
    try {
      const list = await window.storage.list(`mp:${mp.room}:${mp.level}:player:`, true);
      if (!list || !list.keys) return;
      const now = Date.now();
      const seen = new Set();
      for (const key of list.keys){
        const id = k